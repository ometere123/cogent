{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogent.dev/schemas/direct-lab.schema.json",
  "title": "Cogent Native Direct Mode Lab",
  "type": "object",
  "required": ["version", "contract", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "project_root": {"type": "string"},
    "contract": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sender": {"type": "string", "minLength": 1},
        "sdk_version": {"type": "string", "minLength": 1},
        "constructor_args": {"type": "array"},
        "constructor_kwargs": {"type": "object"},
        "check_pickling": {"type": "boolean"}
      }
    },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "webMock": {
      "type": "object",
      "required": ["pattern"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "response": {"type": "object"},
        "status": {"type": "integer"},
        "body": {},
        "headers": {"type": "object"}
      },
      "additionalProperties": true
    },
    "llmMock": {
      "type": "object",
      "required": ["pattern", "response"],
      "additionalProperties": false,
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "response": {"type": "string"}
      }
    },
    "mocks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {"type": "array", "items": {"$ref": "#/$defs/webMock"}},
        "llm": {"type": "array", "items": {"$ref": "#/$defs/llmMock"}},
        "genvm_datetime": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "args": {"type": "array"},
        "kwargs": {"type": "object"},
        "leader": {"$ref": "#/$defs/mocks"},
        "validator": {"$ref": "#/$defs/mocks"},
        "validators": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/mocks"}
        },
        "validator_indices": {
          "oneOf": [
            {"const": "all"},
            {"type": "integer"},
            {"type": "array", "minItems": 1, "items": {"type": "integer"}}
          ]
        },
        "expected_captures": {"type": "integer", "minimum": 1}
      }
    }
  }
}
